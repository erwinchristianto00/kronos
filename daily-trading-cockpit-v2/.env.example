KRONOS_BASE_URL=http://localhost:8001
KRONOS_PREDICT_TIMEOUT_MS=45000
KRONOS_SAMPLE_RUNS=2
SOCIAL_SENTIMENT_PROVIDER=feargreed
SOCIAL_SENTIMENT_URL=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=daily-trading-cockpit-v2/0.1
REDDIT_SUBREDDITS=CryptoCurrency,Bitcoin,ethtrader,solana,Altcoin

# Telegram notifications. Status heartbeat runs automatically every 5 minutes.
NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_PNL_THRESHOLD_NTD=50
NOTIFY_DAILY_PNL_THRESHOLD_NTD=100
NOTIFY_NET_THRESHOLD_R=0.05

# Paper-only adaptive challenger learning. Never affects headline or live trading.
PAPER_CHALLENGER_DIAGNOSTIC_ENABLED=1
PAPER_CHALLENGER_DIAGNOSTIC_MAX_PER_SCAN=1

# Report-only regime engine collection. Keep disabled unless intentionally validating.
REGIME_ENGINE_ENABLED=0

# Keep the checked-in template inert. Set this to 1 only in an untracked local `.env`
# after the Demo Trading account, keys, and /api/live/status have been verified.
LIVE_EXECUTION_ENABLED=0
LIVE_BINANCE_ENV=testnet
LIVE_BINANCE_API_KEY=
# Create credentials only in Binance USD-M Futures Testnet / Demo Trading.
# Keep the real values in an untracked local `.env`, never in this template or Git.
LIVE_BINANCE_API_SECRET=
LIVE_AUTO_ARM=0                 # set 1 only after a manual Demo Trading readiness check
LIVE_MAX_LEVERAGE=2
LIVE_MAX_CONCURRENT_POSITIONS=3
LIVE_MAX_NOTIONAL_PER_TRADE=100
LIVE_MAX_CORRELATED_ALT_LONGS=3
LIVE_MAX_CORRELATED_ALT_SHORTS=3
# Aggregate stop-risk ceiling for one pyramided intent. Defaults to LIVE_RISK_USD_PER_TRADE.
LIVE_MAX_AGGREGATE_INTENT_RISK_USD=5
LIVE_MIRROR_ALL_PAPER=0         # set 1 only to intentionally mirror diagnostic probes too

# Testnet-only simplified orchestration. Ignored on mainnet even if accidentally set.
# Existing independent executors keep managing their open positions, but only the unified
# LiveExecutionEngine path may admit new directional exposure.
UNIFIED_ORCHESTRATOR_ENABLED=0
UNIFIED_DIRECTION_CONFIRM_SAMPLES=2
UNIFIED_CHOPPY_LOCK_SAMPLES=2
UNIFIED_FEATURE_SIGNAL_MAX_AGE_MS=7200000
# Direct testnet proposal adapter: consumes only fresh scanner TRADE_NOW/READY candidates for the
# direction confirmed above. It does not write into or contaminate paper/promotion evidence.
UNIFIED_PROPOSAL_MAX_CANDIDATES=3
UNIFIED_PROPOSAL_MIN_CONFIDENCE=60

# Global HEADLINE concentration caps (anti-correlation safety). HEADLINE orders
# are the only ones that mirror to live, so these bound real exposure: each order
# = 1R (~1% equity), so HEADLINE_MAX_OPEN doubles as a portfolio-heat cap. Stops a
# correlated basket (e.g. many long alts) or the same symbol across lane variants
# from going live all at once. Diagnostic probes are NOT capped (measurement only).
HEADLINE_MAX_OPEN=50            # total open headline orders (≈ 50% peak heat)
HEADLINE_MAX_PER_SYMBOL=2       # open headline orders per symbol
HEADLINE_MAX_PER_DIRECTION=30   # open headline orders per side (long/short)

# Trading assistant: read-only natural-language chat over CORTEX's decision journal + the live/mainnet
# account (routes/trading-assistant.ts). Optional diagnostic tools are strictly read-only and allowlisted;
# the assistant can inspect evidence but can never write, restart, or trade. Dormant unless CORTEX_CHAT_ENABLED=1 AND NVIDIA_API_KEY
# is set. Get a free API key at https://build.nvidia.com — NEVER paste the actual key into chat/commits.
CORTEX_CHAT_ENABLED=0
NVIDIA_API_KEY=
CORTEX_CHAT_MODEL=meta/llama-3.3-70b-instruct
# Optional availability fallback. The primary remains authoritative; fallback is used only after timeout,
# network failure, HTTP 429, or HTTP 5xx, with a short circuit-breaker cooldown.
CORTEX_CHAT_FALLBACK_MODEL=
CORTEX_CHAT_PRIMARY_TIMEOUT_MS=8000
CORTEX_CHAT_FALLBACK_COOLDOWN_MS=600000
CORTEX_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
CORTEX_CHAT_TIMEOUT_MS=20000
CORTEX_CHAT_TOP_P=0.7
CORTEX_CHAT_MAX_TOKENS=1024
CORTEX_CHAT_RATE_LIMIT_PER_MINUTE=10
# Keep 0 unless deliberately using a trusted HTTPS-compatible proxy. This prevents API-key exfiltration
# through an accidental/malicious CORTEX_CHAT_BASE_URL override.
CORTEX_CHAT_ALLOW_CUSTOM_BASE_URL=0
# Optional fixed directory containing cortex-brain.json and cortex-decision-journal.jsonl. Useful when
# the dashboard (3101) reads the same-VPS testnet CORTEX journal (3102) without adding a network route.
CORTEX_CHAT_DATA_DIR=data
CORTEX_CHAT_AUDIT_DATA_DIR=data

# Optional read-only bug-diagnostic tools for the chat assistant. The model may request only the fixed
# list/search/read/git/log/health tools implemented in trading-assistant-diagnostic-tools.ts. There is no
# arbitrary shell, write, restart, env/secret access, or trading authority.
CORTEX_CHAT_DIAGNOSTIC_ENABLED=0
CORTEX_CHAT_ROOT_MAIN=/root/kronos/daily-trading-cockpit-v2
CORTEX_CHAT_ROOT_TESTNET=/root/kronos-testnet/daily-trading-cockpit-v2
CORTEX_CHAT_ROOT_LIVE=/root/kronos-live/daily-trading-cockpit-v2
CORTEX_CHAT_PM2_LOG_DIR=/root/.pm2/logs
CORTEX_CHAT_MAX_FILES=6000
CORTEX_CHAT_MAX_TOOL_OUTPUT_CHARS=30000
# Same-VPS peer for reading live/mainnet read-only status (routes/live.ts GET endpoints only).
LIVE_PEER_BASE_URL=http://127.0.0.1:3103
