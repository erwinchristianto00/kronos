{
  "name": "@dtc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build -w @dtc/shared && tsx watch src/server.ts",
    "test": "npm run build -w @dtc/shared && vitest run --no-file-parallelism --pool=threads --maxWorkers=1",
    "validate:regime": "tsx scripts/run-regime-validation.ts"
  },
  "dependencies": {
    "@dtc/shared": "0.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "undici": "^8.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
