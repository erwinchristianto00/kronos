# Copy this file to .env (same folder) and paste your keys after the = signs.
# Never share this file.

# --- Jev (and Claude) -------------------------------------------------------
# Vercel AI Gateway key: https://vercel.com/dashboard -> AI Gateway -> API Keys -> Create key
# The free tier works but is slow (about one Jev call every 2 seconds).
# $5 of AI Gateway credits removes that limit.
AI_GATEWAY_API_KEY=

# Optional: a direct TypeSafe key, if you're off their waitlist.
TYPESAFE_API_KEY=

# --- 24/7 bot only (Path 2) -------------------------------------------------
# Binance Futures API key and secret. Start with a DEMO TRADING key (fake money).
# Enable only Futures trading. The key must NOT have withdrawal or transfer permission.
# Lock it to your server's IP. The futures account must be in One-way position mode.
# BINANCE_MODE: demo (Binance Demo Trading, real prices), testnet (testnet.binancefuture.com), or live.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_MODE=demo

# Where the bot's fast calls come from: model (the local signal model in models/, default when
# a model for the coin exists) or jev (TypeSafe's Jev through the key above).
SIGNAL_SOURCE=model

# Hard limits, always on:
MAX_POSITION_USD=1000
MAX_DAILY_LOSS_USD=50

# Claude, the 24/7 bot's big-picture brain.
# cli = the Claude Code CLI on this machine, logged in with your Claude subscription (run `claude` once to log in).
# gateway = through the Vercel key above (needs AI Gateway credits; model CLAUDE_MODEL).
CLAUDE_BACKEND=cli
CLAUDE_CLI_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_MODEL=anthropic/claude-sonnet-5

# Real money: leave this blank. Only set BINANCE_MODE=live, and this line to the exact
# phrase "I accept the risk of trading real money", after weeks of demo results.
JEV_LIVE_CONFIRM=
